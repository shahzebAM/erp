generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                     Int                 @id @default(autoincrement())
  firstName              String
  middleName             String?
  lastName               String
  dateOfBirth            DateTime
  address                String
  civilStatus            String
  baseRate               Float
  employmentStatus       String
  tin                    String?             @unique
  sssNumber              String?             @unique
  philhealth             String?             @unique
  pagIbig                String?             @unique
  bankAccount            String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @default(now()) @updatedAt
  cashAdvanceBalance     Float               @default(0)
  cashAdvanceInstallment Float               @default(0)
  company                String              @default("Olten")
  employeeId             String?
  loanBalance            Float               @default(0)
  loanInstallment        Float               @default(0)
  attendances            Attendance[]
  inventoryMovements     InventoryMovement[]
  payrolls               Payroll[]
}

model Admin {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  password    String
  role        String   @default("Admin")
  status      String   @default("Active")
  modules     Json?
  moduleOrder String[] @default([])
  isOnline    Boolean  @default(false)
}

model Settings {
  id         Int    @id @default(autoincrement())
  shiftStart String @default("08:00")
  shiftEnd   String @default("17:00")
  company    String @unique @default("Global")
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       String
  timeIn     String
  timeOut    String
  hours      Float
  reason     String?
  shiftStart String?
  shiftEnd   String?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Payroll {
  id                 Int      @id @default(autoincrement())
  employeeId         Int
  daysWorked         Float
  totalHours         Float
  cashAdvance        Float    @default(0)
  sssDeduction       Float    @default(0)
  pagIbigDeduct      Float    @default(0)
  philhealthDeduct   Float    @default(0)
  tax                Float    @default(0)
  grossPay           Float
  netPay             Float
  createdAt          DateTime @default(now())
  pagIbigLoan        Float    @default(0)
  pagIbigHousingLoan Float    @default(0)
  sssProvident       Float    @default(0)
  sssSalaryLoan      Float    @default(0)
  sssCalamityLoan    Float    @default(0)
  pagIbigCalamity    Float    @default(0)
  pagIbigSalaryLoan  Float    @default(0)
  companyLoan        Float    @default(0)
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Document {
  id              Int      @id @default(autoincrement())
  filename        String
  originalName    String
  mimeType        String
  sizeBytes       Int
  company         String
  geminiFileUri   String?
  geminiFileId    String?
  googleDriveLink String?
  status          String   @default("PROCESSING")
  uploadedBy      String
  createdAt       DateTime @default(now())

  @@index([company])
}

model SearchHistory {
  id               Int      @id @default(autoincrement())
  username         String
  company          String
  query            String
  response         String
  modelUsed        String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  createdAt        DateTime @default(now())
}

model Product {
  id             Int             @id @default(autoincrement())
  company        String
  name           String
  sku            String
  category       String
  purchasePrice  Float
  sellingPrice   Float
  minQuantity    Int             @default(10)
  reorderLevel   Int             @default(20)
  unit           String
  isActive       Boolean         @default(true)
  vatSetting     String
  imageUrl       String?
  barcode        String?
  currentStock   Int             @default(0)
  createdAt      DateTime        @default(now())
  deletedAt      DateTime?
  orderSlipItems OrderSlipItem[]

  @@index([company])
  @@index([sku])
}

model InventoryMovement {
  id             String     @id @default(uuid())
  productId      Int
  productName    String
  sku            String
  type           String
  quantity       Int
  previousStock  Int
  newStock       Int
  reference      String?
  remarks        String?
  date           DateTime   @default(now())
  user           String
  company        String
  batchNumber    String?
  employeeId     Int?
  expirationDate DateTime?
  warehouseId    Int?
  employee       Employee?  @relation(fields: [employeeId], references: [id])
  warehouse      Warehouse? @relation(fields: [warehouseId], references: [id])
}

model Warehouse {
  company            String
  name               String
  createdAt          DateTime            @default(now())
  address            String              @default("Not Specified")
  status             String              @default("Active")
  id                 Int                 @id @default(autoincrement())
  inventoryMovements InventoryMovement[]
}

model WarehouseStock {
  id          String   @id @default(uuid())
  warehouseId String
  productId   Int
  sku         String
  quantity    Int      @default(0)
  company     String
  lastUpdated DateTime @default(now())

  @@unique([warehouseId, productId])
}

model WarehouseTransfer {
  id            String   @id @default(uuid())
  sourceId      String
  destinationId String
  productId     Int
  sku           String
  quantity      Int
  transferDate  DateTime @default(now())
  reference     String?
  user          String
  company       String
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Customer {
  id          String      @id @default(uuid())
  company     String
  name        String
  contact     String?
  phone       String?
  email       String?
  address     String?
  creditLimit Float       @default(0)
  balance     Float       @default(0)
  createdAt   DateTime    @default(now())
  orderSlips  OrderSlip[]
  shortages   Shortage[]
}

model Supplier {
  id             String          @id @default(uuid())
  company        String
  legalName      String
  tradeName      String?
  tin            String
  address        String
  contactPerson  String?
  phone          String?
  email          String?
  paymentTerms   String          @default("Cash on Delivery")
  apBalance      Float           @default(0.00)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  catalog        Json?           @default("[]")
  purchaseOrders PurchaseOrder[]
}

model OrderSlip {
  id          String          @id @default(uuid())
  osNumber    String          @unique
  company     String
  customerId  String
  date        DateTime        @default(now())
  status      String          @default("Draft")
  subtotal    Decimal         @db.Decimal(12, 2)
  vatApplied  Boolean         @default(false)
  vatRate     Decimal         @default(0.12) @db.Decimal(4, 2)
  vatAmount   Decimal         @db.Decimal(12, 2)
  grandTotal  Decimal         @db.Decimal(12, 2)
  createdBy   String
  updatedBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  processedAt DateTime?
  referenceOs String?
  customer    Customer        @relation(fields: [customerId], references: [id])
  items       OrderSlipItem[]
  shortages   Shortage[]

  @@index([company])
}

model OrderSlipItem {
  id           String     @id @default(uuid())
  orderSlipId  String
  productId    Int
  sku          String
  productName  String
  requestedQty Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  lineTotal    Decimal    @db.Decimal(12, 2)
  confirmedQty Int?
  shortageQty  Int?
  orderSlip    OrderSlip  @relation(fields: [orderSlipId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])
  shortages    Shortage[]
}

model Shortage {
  id                  String         @id @default(uuid())
  orderSlipId         String?
  orderSlipItemId     String?
  company             String
  customerId          String?
  osNumber            String?
  sku                 String
  productName         String
  requestedQty        Int
  confirmedQty        Int
  shortageQty         Int
  status              String         @default("Open")
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  poNumber            String?
  purchaseOrderId     String?
  purchaseOrderItemId String?
  customer            Customer?      @relation(fields: [customerId], references: [id])
  orderSlip           OrderSlip?     @relation(fields: [orderSlipId], references: [id], onDelete: Cascade)
  orderSlipItem       OrderSlipItem? @relation(fields: [orderSlipItemId], references: [id], onDelete: Cascade)

  @@index([company])
  @@index([orderSlipId])
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique
  company     String
  status      String
  subtotal    Float
  vatApplied  Boolean             @default(false)
  vatRate     Float               @default(0.12)
  vatAmount   Float               @default(0)
  grandTotal  Float
  createdBy   String
  updatedBy   String?
  createdAt   DateTime            @default(now())
  receivedAt  DateTime?
  osReference String?
  supplierId  String?
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       Int
  sku             String
  productName     String
  requestedQty    Int
  confirmedQty    Int?
  shortageQty     Int?
  unitCost        Float
  lineTotal       Float
  po              PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}
